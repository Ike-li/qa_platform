# QA Platform environment variables
# Copy to .env and adjust values for your environment.

# --- Core ---
QAP_APP_NAME="QA Platform"
QAP_DEBUG=true
QAP_ENVIRONMENT=development

# --- PostgreSQL ---
QAP_DATABASE_URL=postgresql+asyncpg://qaplatform:qaplatform@localhost:5432/qaplatform
QAP_DATABASE_POOL_SIZE=10
QAP_DATABASE_MAX_OVERFLOW=20

# --- Redis ---
QAP_REDIS_URL=redis://localhost:6379/0
QAP_REDIS_MAX_CONNECTIONS=50

# --- Object storage (MinIO) ---
QAP_S3_ENDPOINT=http://localhost:9000
QAP_S3_ACCESS_KEY=minioadmin
QAP_S3_SECRET_KEY=minioadmin
QAP_S3_BUCKET=qa-platform
QAP_S3_REGION=us-east-1

# --- Security ---
QAP_JWT_SECRET=change-me-in-production
QAP_JWT_ACCESS_TOKEN_TTL=3600
QAP_JWT_REFRESH_TOKEN_TTL=604800
QAP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Execution engine ---
QAP_MAX_CONCURRENT_RUNS=5
QAP_MAX_CONCURRENT_PER_PROJECT=3
QAP_DEFAULT_TIMEOUT_SECONDS=1800
QAP_PREPARING_TIMEOUT_SECONDS=300
QAP_COLLECTING_TIMEOUT_SECONDS=180
QAP_MAX_EVENT_CHAIN_DEPTH=5
QAP_DOCKER_HOST=unix:///var/run/docker.sock

# --- Rate limiting ---
QAP_RATE_LIMIT_REQUESTS=100
QAP_RATE_LIMIT_WINDOW_SECONDS=60
QAP_RATE_LIMIT_AUTH_FAILURE=5
QAP_RATE_LIMIT_AUTH_FAILURE_WINDOW=60

# --- Data retention ---
QAP_RETENTION_RUNS_DAYS=90
QAP_RETENTION_REPORTS_DAYS=30
QAP_RETENTION_AUDIT_DAYS=1095

# --- Observability ---
QAP_OTEL_EXPORTER_ENDPOINT=
QAP_LOG_LEVEL=INFO
QAP_LOG_FORMAT=console

# --- MinIO (for docker-compose) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
